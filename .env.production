# Public hosting origin for canonical URLs and social preview images.
# These values contain no secrets. Host environment variables can override them.
SEO_SITE_URL=https://sri-vidya-classes.netlify.app
# The supplied Netlify origin needs no custom domain or Google verification file.
SEO_ENV=production
SEO_DOMAIN_VERIFIED=true
SEO_ALLOW_INDEXING=true
# Owner approved current published business details and claims on 2026-10-31.
SEO_BUSINESS_APPROVED=true
